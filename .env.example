# PostgreSQL bağlantısı — kendi bilgilerinizle değiştirin
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finecrm?schema=public"

# Bildirim (email) simülasyonu — SENT/gönderim davranışını taklit eder
# "console" => e-postalar terminale loglanır (varsayılan)
NOTIFICATION_TRANSPORT="console"
NOTIFICATION_FROM="no-reply@finecrm.local"
